# Optional for local/dev. Preferred for day-to-day use:
#   run `agent-v1` once — it saves ~/.config/agent-v1/config.toml
#
# Copy to .env and fill in keys to override the user config:
#   cp .env.example .env
# Or export the same variables in your shell.
#
# Set exactly one LLM_PROVIDER, then fill that provider's API key.
# Unused keys can stay empty.
#
# Never commit .env — it contains secrets.
# Priority: env / .env → ~/.config/agent-v1/config.toml → built-in defaults.

# =============================================================================
# Provider (pick one): groq | deepseek | agentrouter
# =============================================================================
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com) ---
# LLM_PROVIDER=groq
GROQ_API_KEY=
# MODEL_ID=llama-3.1-70b-versatile

# --- DeepSeek (https://platform.deepseek.com) ---
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# MODEL_ID=deepseek-v4-flash

# --- AgentRouter (https://agentrouter.org/console/token) ---
# LLM_PROVIDER=agentrouter
# AGENTROUTER_API_KEY=
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# MODEL_ID=glm-5.2

# Workspace — optional. By default the CLI uses:
#   1. --workspace <path>
#   2. nearest parent directory containing .git
#   3. current directory
# WORKSPACE_ROOT=

# =============================================================================
# Runtime
# =============================================================================
# Interactive sessions default to confirm-before-edit even if unset.
# One-shot runs default to auto. Values: auto | confirm | readonly
# EDIT_POLICY=confirm

# Ordinary runs: 40. Override higher only for deliberate long experiments.
MAX_STEPS=40
MAX_CONTEXT_TOKENS=16000
CONTEXT_RESERVE_TOKENS=2048
KEEP_RECENT_SESSION_MESSAGES=20
STEP_DELAY_MS=0

# After a successful apply_patch/write_file, run the preferred discovered check
# (typecheck/lint/test/build) and attach the result to the edit tool output.
# Set to 0/false/off to disable.
# AUTO_POST_EDIT_VERIFY=1

# Optional rough USD estimates (per million tokens). Unset → cost shows "unavailable".
# PRICE_INPUT_PER_MTOK=0.50
# PRICE_CACHED_INPUT_PER_MTOK=0.05
# PRICE_OUTPUT_PER_MTOK=1.50
