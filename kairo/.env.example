# Optional local overrides. Day-to-day: run `kairo` once → ~/.config/kairo/config.toml
# Copy: cp .env.example .env   (never commit .env)
# Priority: env / .env → config.toml → defaults

# Provider: groq | deepseek | agentrouter
LLM_PROVIDER=groq

# Fill the key for the provider above
GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# AGENTROUTER_API_KEY=
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# Optional model override (defaults: llama-3.1-70b-versatile / deepseek-v4-flash / glm-5.2)
# MODEL_ID=

# Optional workspace override (else: --workspace → nearest .git → cwd)
# WORKSPACE_ROOT=

# Runtime (defaults are fine for most use)
# EDIT_POLICY=confirm
# MAX_STEPS=40
# AUTO_POST_EDIT_VERIFY=1
